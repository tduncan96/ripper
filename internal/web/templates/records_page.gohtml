<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Rip Records</title>
<style>
  body { font-family: system-ui, sans-serif; background: #1a1a1a; color: #e0e0e0; margin: 2rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #333; }
  th { color: #9ab; }
  tr:hover td { background: #222; }
  .ok { color: #6c6; }
  .fail { color: #e66; }
</style>
</head>
<body>
<h1>Rip Records</h1>
<table>
  <thead>
    <tr><th>ID</th><th>Start</th><th>End</th><th>Title</th><th>Device</th><th>Exit</th><th>Rip MB</th><th>Move MB</th></tr>
  </thead>
  <tbody>
    {{range .}}
    <tr>
      <td>{{.RunID}}</td>
      <td>{{.StartTime}}</td>
      <td>{{.EndTime}}</td>
      <td>{{.Title}}</td>
      <td>{{.Device}}</td>
      <td class="{{if eq .ExitCode 0}}ok{{else}}fail{{end}}">{{.ExitCode}}</td>
      <td>{{.TotalRipMB}}</td>
      <td>{{.TotalMvMB}}</td>
    </tr>
    {{else}}
    <tr><td colspan="8">No records yet.</td></tr>
    {{end}}
  </tbody>
</table>
</body>
</html>